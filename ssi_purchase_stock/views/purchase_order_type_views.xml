<odoo>
<record id="purchase_order_type_view_form" model="ir.ui.view">
    <field name="name">purchase_order_type: Allowed Picking Type Form</field>
    <field name="model">purchase_order_type</field>
    <field name="inherit_id" ref="ssi_purchase.purchase_order_type_view_form" />
    <field name="arch" type="xml">
        <data>
        <xpath expr="//page[@name='note']" position="before">
            <page name="configuration" string="Inventories">
                <group name="config">
                    <field
                                name="picking_type_selection_method"
                                string="Selecton Method"
                            />
                    <field
                                name="allowed_picking_type_ids"
                                attrs="{'invisible':[('picking_type_selection_method','!=','manual')]}"
                                string="Allowed Deliver To"
                            />
                    <field
                                name="picking_type_domain"
                                widget="domain"
                                options="{'model': 'stock.picking.type', 'in_dialog': True}"
                                attrs="{'invisible':[('picking_type_selection_method','!=','domain')]}"
                                string="Domain"
                            />
                    <field
                                name="picking_type_python_code"
                                widget="ace"
                                attrs="{'invisible':[('picking_type_selection_method','!=','code')]}"
                                string="Python Code"
                            />
                    <field name="default_picking_type_id" />
                </group>
            </page>
        </xpath>
        </data>
    </field>
</record>
</odoo>
